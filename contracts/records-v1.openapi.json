{
  "openapi": "3.1.0",
  "info": { "title": "Tallyboard records sync", "version": "1.0.0" },
  "paths": {
    "/v1/records/{key}": {
      "parameters": [
        { "name": "key", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" } }
      ],
      "put": {
        "summary": "Store a value under a key; the client's value always overwrites the stored one",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordWrite" } } }
        },
        "responses": {
          "200": {
            "description": "Stored and acknowledged",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordAcknowledgement" } } }
          },
          "422": { "description": "Invalid key or body" }
        }
      },
      "get": {
        "summary": "Read the value stored under a key",
        "responses": {
          "200": {
            "description": "The stored record",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordRead" } } }
          },
          "404": {
            "description": "No record under this key",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotFound" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RecordWrite": {
        "type": "object",
        "required": ["value"],
        "properties": { "value": {} }
      },
      "RecordAcknowledgement": {
        "type": "object",
        "required": ["key", "stored_at"],
        "properties": {
          "key": { "type": "string" },
          "stored_at": { "type": "string", "format": "date-time" }
        }
      },
      "RecordRead": {
        "type": "object",
        "required": ["key", "value", "stored_at"],
        "properties": {
          "key": { "type": "string" },
          "value": {},
          "stored_at": { "type": "string", "format": "date-time" }
        }
      },
      "NotFound": {
        "type": "object",
        "required": ["detail"],
        "properties": { "detail": { "type": "string" } }
      }
    }
  }
}
